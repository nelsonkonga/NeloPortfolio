# Le préfixe VITE_ est obligatoire pour une valeur lue par la page dans le navigateur.
# Sans ce préfixe, Vite ne la transmet pas, et l'écran ne peut pas l'afficher.
# Une valeur VITE_ est visible par quiconque ouvre le site. On n'y met que ce qui doit être vu.
# Une clé secrète (prestataire, service role) s'écrit SANS VITE_ et reste sur le serveur.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Numéros affichés au client pour envoyer le transfert. Ils sont publics par nature.
# Dès qu'un numéro est renseigné, la page le montre et n'ouvre plus la caisse du bac à sable.
VITE_MTN_MOMO_NUMBER=
VITE_ORANGE_MONEY_NUMBER=

# Lien public du calendrier d'appel, affiché sur /appel. Visible par le navigateur.
# Exemple : https://calendly.com/nelo/appel-20-min
# Tant que la ligne est vide, la page d'appel n'ouvre pas le parcours d'une formule.
VITE_CALENDLY_URL=

# Adresse appelée par le navigateur. Le secret du prestataire ne va pas ici.
# Si cette ligne reste vide, la page en https appelle elle-même /api/momo.
# POST JSON : email, phone, hotel, formule, visit, method (mtn ou orange), amountLabel, successUrl, cancelUrl
# Réponse attendue : { "url": "https://..." }
VITE_MOMO_ENDPOINT=

# Clé secrète Moneroo, lue uniquement par /api/momo. Sans le préfixe VITE_.
# Sur Vercel : MONEROO_SECRET_KEY. Ne jamais la coller dans le code.
MONEROO_SECRET_KEY=

# Clés Fapshi du service Nelo, bloc API (paiements réels). Sans le préfixe VITE_.
# Quand les deux sont remplies, la page ouvre le paiement Fapshi.
# Sur Vercel : FAPSHI_API_USER et FAPSHI_API_KEY. Ne jamais les coller dans le code.
FAPSHI_API_USER=
FAPSHI_API_KEY=
