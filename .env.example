# Laisser vide tant que les comptes ne sont pas créés.
# Le site reste ouvert : aucun débit, et aucun message ne dit qu'une demande est enregistrée.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# POST JSON : email, phone, hotel, formule, visit, method, amountLabel, successUrl, cancelUrl
# Réponse attendue : { "url": "https://checkout.stripe.com/..." }
VITE_CHECKOUT_ENDPOINT=

# Lien Stripe Payment Link, secours si l'endpoint carte ne répond pas.
VITE_STRIPE_CHECKOUT_URL=

# POST JSON, même corps. Réponse : { "url": "https://www.paypal.com/..." }
VITE_PAYPAL_ENDPOINT=

# Lien PayPal, secours.
VITE_PAYPAL_CHECKOUT_URL=
